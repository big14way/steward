# Network (defaults are Arc Testnet). Mainnet: CHAIN_ID=5042, ARC_RPC=https://rpc.mainnet.arc.io, EXPLORER=https://explorer.arc.io,
# OWNER_SIGNER=local + OWNER_PRIVATE_KEY until Circle mainnet access is granted (then CIRCLE_BLOCKCHAIN=ARC),
# CCTP_TOKEN_MESSENGER / CCTP_MESSAGE_TRANSMITTER / IRIS_API and USYC_TELLER / USYC_TOKEN / USYC_ENTITLEMENTS per docs.arc.io.
CHAIN_ID=5042002
EXPLORER=https://explorer.testnet.arc.io
