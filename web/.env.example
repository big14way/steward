NEXT_PUBLIC_API=/api                       # same-origin proxy (see next.config.ts); set a full URL only if the API is hosted separately without the proxy
NEXT_PUBLIC_ALLOWANCE_MANAGER=0x
NEXT_PUBLIC_EXPLORER=https://explorer.testnet.arc.io
NEXT_PUBLIC_JUDGE_MODE=true
API_INTERNAL=http://127.0.0.1:8001   # server-side fetch target when the API is co-located (optional)
NEXT_PUBLIC_JUDGE_SECRET=            # optional: shown in the judge banner; must equal the API's JUDGE_SECRET (approve/reject only)
